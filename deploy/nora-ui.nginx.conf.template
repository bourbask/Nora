# Gabarit nginx (substitution de NORA_API_TOKEN par l'image au démarrage).
# nora-ui — sert le build statique (dist) et proxifie /api vers nora-api.
# Même origine en prod : le navigateur ne voit jamais le token Firefly.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # /api/* -> backend interne (le préfixe /api est conservé, routes FastAPI sous /api).
    location /api/ {
        proxy_pass http://nora-api:8000;
        # Jeton ajouté côté serveur : le navigateur ne le voit jamais.
        proxy_set_header Authorization "Bearer ${NORA_API_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Pages légales exigées par le prestataire d'agrégation.
    location = /confidentialite { alias /usr/share/nginx/legal/confidentialite.html; default_type text/html; }
    location = /conditions      { alias /usr/share/nginx/legal/conditions.html;      default_type text/html; }

    # SPA : tout le reste retombe sur index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
